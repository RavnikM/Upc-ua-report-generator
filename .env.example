# Database Connection URL
# Local SQLite (Async):
DATABASE_URL=sqlite+aiosqlite:///./opc_cycle_reports.db
# Production MS SQL Server (Async via aioodbc / ODBC Driver 18):
# DATABASE_URL=mssql+aioodbc://username:password@server_host:1433/database_name?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# Siemens S7-1500 OPC-UA Endpoint
OPCUA_ENDPOINT_URL=opc.tcp://192.168.0.1:4840
OPCUA_POLL_INTERVAL_SECONDS=0.5
